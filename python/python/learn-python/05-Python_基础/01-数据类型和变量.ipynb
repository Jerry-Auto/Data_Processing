   "source": [
    "# 数据类型和变量 - 进制转换\n",
    "\n",
    "演示整数和十六进制表示，使用 `hex()` 函数将整数转换为十六进制字符串。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 将整数转换为十六进制\n",
    "n1 = 255\n",
    "n2 = 1000\n",
    "\n",
    "print(\"n1: %s\" % hex(n1))\n",
    "print(\"n2: %s\" % hex(n2))"
   ]
  }
 ],
