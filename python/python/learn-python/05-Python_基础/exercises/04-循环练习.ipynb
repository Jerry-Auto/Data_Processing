    "# 循环练习\n",
    "\n",
    "对应教程：5.6 循环\n",
    "\n",
    "演示 Python 中的 `for` 循环用法。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 计算 1 到 100 的和\n",
    "sum_val = 0\n",
    "for i in range(101):\n",
    "    sum_val = sum_val + i\n",
    "\n",
    "print(\"1+2+...+100 =\", sum_val)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 遍历列表并打印问候语\n",
    "L = ['Bart', 'Lisa', 'Adam']\n",
    "\n",
    "for name in L:\n",
    "    print(\"Hello, %s!\" % name)"
   ]
  }
