   "source": [
    "# 条件判断练习\n",
    "\n",
    "演示 Python 中 `if` 条件判断的用法，包括布尔值的真假判断。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# None 在布尔上下文中被视为 False\n",
    "if None:\n",
    "    print(True)\n",
    "else:\n",
    "    print(False)"
   ]
  }
