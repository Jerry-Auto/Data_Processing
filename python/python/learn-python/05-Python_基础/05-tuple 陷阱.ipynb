   "source": [
    "# tuple 不可变性陷阱\n",
    "\n",
    "演示 tuple 的\"指向不变\"特性：tuple 的元素本身可变时，内容可以改变。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# tuple 的元素包含 list\n",
    "l = [1, 2, 3]\n",
    "x = 1\n",
    "t = (l, x)\n",
    "\n",
    "# t[1] = 2  # TypeError: tuple 不支持元素赋值\n",
    "\n",
    "# 但可以修改 tuple 中 list 元素的内容\n",
    "t[0][0] = 2\n",
    "print(\"t:\", t)\n",
    "\n",
    "# tuple 的\"不变\"是指每个元素的指向不变，而不是元素内容不可变"
   ]
  }
 ],
