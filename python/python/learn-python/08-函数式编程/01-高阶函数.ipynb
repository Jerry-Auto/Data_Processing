   "source": [
    "# 高阶函数\n",
    "\n",
    "演示高阶函数的概念：函数可以作为参数传递给另一个函数。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 高阶函数：函数作为参数\n",
    "def add(a, b, f):\n",
    "    return f(a) + f(b)\n",
    "\n",
    "# 使用 abs 函数作为参数\n",
    "print(add(-1, -2, abs))  # 输出：3"
   ]
  }
 ],
