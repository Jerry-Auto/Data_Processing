   "source": [
    "# 函数的参数 - 命名关键字参数\n",
    "\n",
    "演示命名关键字参数的用法，使用 `*` 分隔普通参数和命名关键字参数。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 命名关键字参数必须传入参数名\n",
    "def person(name, age, *, city, job):\n",
    "    print(name, age, city, job)\n",
    "\n",
    "# person(\"wy\", 23)  # TypeError: 缺少必填的命名关键字参数\n",
    "\n",
    "# 正确调用方式\n",
    "person(\"wy\", 23, city=\"lyg\", job=\"student\")"
   ]
  }
 ],
