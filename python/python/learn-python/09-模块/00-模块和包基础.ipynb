{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 包和模块管理\n",
    "\n",
    "Python 中模块和包的组织方式。"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 模块导入方式"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. 导入整个模块\n",
    "import math\n",
    "print(math.sqrt(16))\n",
    "\n",
    "# 2. 导入特定函数\n",
    "from math import sqrt, sin\n",
    "print(sqrt(25))\n",
    "\n",
    "# 3. 导入并重命名\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# 4. 导入所有 (不推荐)\n",
    "# from math import *"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 创建自己的模块"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 保存为 mymodule.py\n",
    "# 内容如下:\n",
    "\n",
    "# mymodule.py\n",
    \"\"\"我的自定义模块\"\"\"\n",
    "\n",
    "def greet(name):\n",
    "    \"\"\"打招呼\"\"\"\n",
    "    return f'Hello, {name}!'\n",
    "\n",
    "def add(a, b):\n",
    "    \"\"\"加法\"\"\"\n",
    "    return a + b\n",
    "\n",
    "PI = 3.14159\n",
    "\n",
    "# 使用时:\n",
    "# import mymodule\n",
    "# print(mymodule.greet('World'))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## __name__ == '__main__'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 模块可以包含测试代码\n",
    "# 只有直接运行模块时才会执行，被导入时不会执行\n",
    "\n",
    "# mymodule.py\n",
    "def main():\n",
    "    print('这是测试代码')\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    main()\n",
    "\n",
    "# __name__ 的值:\n",
    "# - 直接运行文件时：'__main__'\n",
    "# - 被导入时：模块名"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 包的结构"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 包是包含__init__.py 的目录\n",
    "# 结构示例:\n",
    "\n",
    "# mypackage/\n",
    "#     __init__.py\n",
    "#     module1.py\n",
    "#     module2.py\n",
    "#     subpackage/\n",
    "#         __init__.py\n",
    "#         module3.py\n",
    "\n",
    "# 导入包中的模块:\n",
    "# from mypackage import module1\n",
    "# from mypackage.subpackage import module3"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 常用标准库模块"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 常用标准库\n",
    "import os       # 操作系统接口\n",
    "import sys      # Python 解释器相关\n",
    "import re       # 正则表达式\n",
    "import json     # JSON 处理\n",
    "import random   # 随机数\n",
    "import time     # 时间相关\n",
    "import datetime # 日期时间\n",
    "import collections  # 扩展集合类型\n",
    "import itertools    # 迭代工具\n",
    "\n",
    "print('标准库模块导入成功')"
   ]
  }
 ],
